# 复制为项目根目录的 .env 后再执行 docker compose up -d
# 不要提交真实密码与密钥

MYSQL_ROOT_PASSWORD=change-me-strong
MYSQL_DATABASE=fitplan

JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=120

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong
ADMIN_NICKNAME=管理员

FITPLAN_HTTP_PORT=80
FITPLAN_FRONT=http://localhost
FITPLAN_ORIGINS=http://localhost
FITPLAN_PUBLIC_BASE=

FITPLAN_PRO_PRICE_YUAN=8
FITPLAN_PRO_DAYS=30
FITPLAN_PRO_SUBJECT=练 · Pro 会员

# 支付宝可选；不配置则只能账号密码登录，无法收款与退款
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
