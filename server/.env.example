# 复制成同目录的 .env，把密码填进去。这个文件只在你这台机器上，不进 dist、不会发布到站点。

# ===== 只开账号密码登录要这些（不需要支付宝应用，本机起了就能注册、登录、传记录）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 别用 root 也行：建一个只管 fitplan 库的账号更稳
#   CREATE USER 'fitplan'@'localhost' IDENTIFIED BY '你自己定的密码';
#   GRANT ALL ON fitplan.* TO 'fitplan'@'localhost';
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fitplan

# 接口端口；和 vite.config.js 的代理目标保持一致
#FITPLAN_API_PORT=8787
# 会话令牌有效期（天）
#FITPLAN_SESSION_DAYS=30
# 允许跨域调 /api 的来源，逗号分隔；留空用代码里的默认三个（5173 / 8082 / 线上站点）
#FITPLAN_ORIGINS=http://localhost:5173,http://localhost:8082,https://minute-fitplan-9u7zherxrt7.qoder.zone
# 打开后 /api/health 才回「缺哪些环境变量、CORS 白名单里有谁」。排查时开，挂着隧道对外时别开
#FITPLAN_HEALTH_DETAIL=1

# ===== 要用支付宝时才填：授权登录 + 收款 =====
# 授权完成之后跳回的前端地址
#FITPLAN_FRONT=http://localhost:5173
# 支付宝异步通知要打得到的公网地址，本机地址支付宝进不来
#FITPLAN_PUBLIC_BASE=https://xxxx.trycloudflare.com
#ALIPAY_APP_ID=
# 网关默认是正式环境；沙箱换成 https://openapi-sandbox.dl.alipaydev.com/gateway.do
#ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 私钥两种给法：直接贴内容，或者指向 PEM 文件
#ALIPAY_APP_PRIVATE_KEY=
#ALIPAY_APP_PRIVATE_KEY_FILE=
# 验支付宝回执用的公钥
#ALIPAY_PUBLIC_KEY=
#ALIPAY_PUBLIC_KEY_FILE=

# ===== Pro 定价（改这里就够，价格由后端说了算）=====
#FITPLAN_PRO_PRICE_YUAN=8
#FITPLAN_PRO_DAYS=30
#FITPLAN_PRO_SUBJECT=练 · Pro 会员

# ===== 管理后台（可选）=====
# 不配则 /api/admin/** 全部回 404；账号只在后端启动时创建一次，已存在不会覆盖密码
# 密码至少 12 位，生产环境用随机串
#FITPLAN_ADMIN_LOGIN=
#FITPLAN_ADMIN_PASSWORD=
# 管理会话有效期（小时），默认 12
#FITPLAN_ADMIN_SESSION_HOURS=12
# 可选 IP 白名单，逗号分隔；留空不限制
#FITPLAN_ADMIN_IPS=
